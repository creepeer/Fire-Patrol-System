<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DPlanUserMapper">
    
    <resultMap type="DPlanUser" id="DPlanUserResult">
        <result property="id"    column="id"    />
        <result property="planId"    column="plan_id"    />
        <result property="userId"    column="user_id"    />
        <result property="zoneId"    column="zone_id"    />
        <result property="creator"    column="creator"    />
        <result property="creatorTime"    column="creator_time"    />
        <result property="modifier"    column="modifier"    />
        <result property="modifierTime"    column="modifier_time"    />
    </resultMap>

    <sql id="selectDPlanUserVo">
        select id, plan_id, user_id, zone_id, creator, creator_time, modifier, modifier_time from d_plan_user
    </sql>

    <select id="selectDPlanUserList" parameterType="DPlanUser" resultMap="DPlanUserResult">
        <include refid="selectDPlanUserVo"/>
        <where>  
            <if test="planId != null "> and plan_id = #{planId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="zoneId != null "> and zone_id = #{zoneId}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="creatorTime != null "> and creator_time = #{creatorTime}</if>
            <if test="modifier != null  and modifier != ''"> and modifier = #{modifier}</if>
            <if test="modifierTime != null "> and modifier_time = #{modifierTime}</if>
        </where>
    </select>
    
    <select id="selectDPlanUserById" parameterType="Long" resultMap="DPlanUserResult">
        <include refid="selectDPlanUserVo"/>
        where id = #{id}
    </select>

    <insert id="insertDPlanUser" parameterType="DPlanUser" useGeneratedKeys="true" keyProperty="id">
        insert into d_plan_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planId != null">plan_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="zoneId != null">zone_id,</if>
            <if test="creator != null">creator,</if>
            <if test="creatorTime != null">creator_time,</if>
            <if test="modifier != null">modifier,</if>
            <if test="modifierTime != null">modifier_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planId != null">#{planId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="zoneId != null">#{zoneId},</if>
            <if test="creator != null">#{creator},</if>
            <if test="creatorTime != null">#{creatorTime},</if>
            <if test="modifier != null">#{modifier},</if>
            <if test="modifierTime != null">#{modifierTime},</if>
         </trim>
    </insert>

    <update id="updateDPlanUser" parameterType="DPlanUser">
        update d_plan_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="zoneId != null">zone_id = #{zoneId},</if>
            <if test="creator != null">creator = #{creator},</if>
            <if test="creatorTime != null">creator_time = #{creatorTime},</if>
            <if test="modifier != null">modifier = #{modifier},</if>
            <if test="modifierTime != null">modifier_time = #{modifierTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDPlanUserById" parameterType="Long">
        delete from d_plan_user where id = #{id}
    </delete>

    <delete id="deleteDPlanUserByIds" parameterType="String">
        delete from d_plan_user where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>