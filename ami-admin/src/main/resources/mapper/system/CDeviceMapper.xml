<mapper namespace="com.ruoyi.system.mapper.CDeviceMapper">
    
    <resultMap type="CDevice" id="CDeviceResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="categoryId"    column="category_id"    />
        <result property="projectId"    column="project_id"    />
        <result property="zoneId1"    column="zone_id1"    />
        <result property="zoneId2"    column="zone_id2"    />
        <result property="zoneId3"    column="zone_id3"    />
        <result property="location"    column="location"    />
        <result property="relatedLocation"    column="related_location"    />
        <result property="brand"    column="brand"    />
        <result property="model"    column="model"    />
        <result property="isHost"    column="is_host"    />
        <result property="isBus"    column="is_bus"    />
        <result property="parentDeviceId"    column="parent_device_id"    />
        <result property="productionDate"    column="production_date"    />
        <result property="startDate"    column="start_date"    />
        <result property="warrantyStart"    column="warranty_start"    />
        <result property="serviceLife"    column="service_life"    />
        <result property="deviceStatus"    column="device_status"    />
        <result property="bindStatus"    column="bind_status"    />
