        <result property="creatorTime"    column="creator_time"    />
        <result property="modifier"    column="modifier"    />
        <result property="modifierTime"    column="modifier_time"    />
    </resultMap>

    <sql id="selectCDeviceVo">
        select id, name, category_id, project_id, zone_id1, zone_id2, zone_id3, location, related_location, brand, model, is_host, is_bus, parent_device_id, production_date, start_date, warranty_start, service_life, device_status, bind_status, qr_code, qr_url, diagram_2d, lng, lat, remark, deleted, creator, creator_time, modifier, modifier_time from c_device
    </sql>
    <!-- 根据区域ID查询设备列表 -->
    <select id="selectCDeviceByZoneId" parameterType="Long" resultMap="CDeviceResult">
        <include refid="selectCDeviceVo"/>
        WHERE (zone_id1 = #{zoneId} OR zone_id2 = #{zoneId} OR zone_id3 = #{zoneId})
        AND deleted = 0
        ORDER BY id DESC
    </select>
    <select id="selectCDevicePlanByZoneId" parameterType="Long" resultMap="CDeviceResult">
        <include refid="selectCDeviceVo"/>
        WHERE deleted = 0
        AND (

        (#{zoneId} = zone_id3)
        OR

        (#{zoneId} = zone_id2 AND zone_id3 IS NULL)
        OR

        (#{zoneId} = zone_id1 AND zone_id2 IS NULL AND zone_id3 IS NULL)
        )
        ORDER BY id DESC
    </select>
    <select id="selectCDeviceList" parameterType="CDevice" resultMap="CDeviceResult">
        <include refid="selectCDeviceVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="zoneId1 != null "> and zone_id1 = #{zoneId1}</if>
            <if test="zoneId2 != null "> and zone_id2 = #{zoneId2}</if>
            <if test="zoneId3 != null "> and zone_id3 = #{zoneId3}</if>
            <if test="location != null  and location != ''"> and location = #{location}</if>
            <if test="relatedLocation != null  and relatedLocation != ''"> and related_location = #{relatedLocation}</if>
            <if test="brand != null  and brand != ''"> and brand = #{brand}</if>
            <if test="model != null  and model != ''"> and model = #{model}</if>
            <if test="isHost != null "> and is_host = #{isHost}</if>
            <if test="isBus != null "> and is_bus = #{isBus}</if>
            <if test="parentDeviceId != null "> and parent_device_id = #{parentDeviceId}</if>
            <if test="productionDate != null "> and production_date = #{productionDate}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="warrantyStart != null "> and warranty_start = #{warrantyStart}</if>
            <if test="serviceLife != null "> and service_life = #{serviceLife}</if>
            <if test="deviceStatus != null "> and device_status = #{deviceStatus}</if>
            <if test="bindStatus != null "> and bind_status = #{bindStatus}</if>
            <if test="qrCode != null  and qrCode != ''"> and qr_code = #{qrCode}</if>
            <if test="qrUrl != null  and qrUrl != ''"> and qr_url = #{qrUrl}</if>
            <if test="diagram2d != null  and diagram2d != ''"> and diagram_2d = #{diagram2d}</if>
            <if test="lng != null "> and lng = #{lng}</if>
            <if test="lat != null "> and lat = #{lat}</if>
            <if test="deleted != null "> and deleted = #{deleted}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="creatorTime != null "> and creator_time = #{creatorTime}</if>
            <if test="modifier != null  and modifier != ''"> and modifier = #{modifier}</if>
            <if test="modifierTime != null "> and modifier_time = #{modifierTime}</if>
        </where>
    </select>
    
    <select id="selectCDeviceById" parameterType="Long" resultMap="CDeviceResult">
        <include refid="selectCDeviceVo"/>
        where id = #{id}
    </select>

    <insert id="insertCDevice" parameterType="CDevice" useGeneratedKeys="true" keyProperty="id">
