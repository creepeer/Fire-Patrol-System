    <delete id="deleteCDeviceById" parameterType="Long">
        delete from c_device where id = #{id}
    </delete>

    <delete id="deleteCDeviceByIds" parameterType="String">
        delete from c_device where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
