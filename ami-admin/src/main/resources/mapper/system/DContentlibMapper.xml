<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DContentlibMapper">
    
    <resultMap type="DContentlib" id="DContentlibResult">
        <result property="id"    column="id"    />
        <result property="pid"    column="pid"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="location"    column="location"    />
        <result property="remark"    column="remark"    />
        <result property="deleted"    column="deleted"    />
        <result property="creator"    column="creator"    />
        <result property="creatorTime"    column="creator_time"    />
        <result property="modifier"    column="modifier"    />
        <result property="modifierTime"    column="modifier_time"    />
    </resultMap>

    <sql id="selectDContentlibVo">
        select id, name, pid, status, location, remark, deleted, creator, creator_time, modifier, modifier_time from d_contentlib
    </sql>

    <select id="selectDContentlibList" parameterType="DContentlib" resultMap="DContentlibResult">
        <include refid="selectDContentlibVo"/>
        <where>  
            <if test="pid != null "> and pid = #{pid}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="name != null "> and name = #{name}</if>
            <if test="location != null  and location != ''"> and location = #{location}</if>
            <if test="deleted != null "> and deleted = #{deleted}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="creatorTime != null "> and creator_time = #{creatorTime}</if>
            <if test="modifier != null  and modifier != ''"> and modifier = #{modifier}</if>
            <if test="modifierTime != null "> and modifier_time = #{modifierTime}</if>
        </where>
    </select>
    
    <select id="selectDContentlibById" parameterType="Long" resultMap="DContentlibResult">
        <include refid="selectDContentlibVo"/>
        where id = #{id}
    </select>

    <insert id="insertDContentlib" parameterType="DContentlib" useGeneratedKeys="true" keyProperty="id">
        insert into d_contentlib
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pid != null">pid,</if>
            <if test="name != null "> name,</if>
            <if test="status != null">status,</if>
            <if test="location != null and location != ''">location,</if>
            <if test="remark != null">remark,</if>
            <if test="deleted != null">deleted,</if>
            <if test="creator != null and creator != ''">creator,</if>
            <if test="creatorTime != null">creator_time,</if>
            <if test="modifier != null and modifier != ''">modifier,</if>
            <if test="modifierTime != null">modifier_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pid != null">#{pid},</if>
            <if test="name != null ">  #{name},</if>
            <if test="status != null">#{status},</if>
            <if test="location != null and location != ''">#{location},</if>
            <if test="remark != null">#{remark},</if>
            <if test="deleted != null">#{deleted},</if>
            <if test="creator != null and creator != ''">#{creator},</if>
            <if test="creatorTime != null">#{creatorTime},</if>
            <if test="modifier != null and modifier != ''">#{modifier},</if>
            <if test="modifierTime != null">#{modifierTime},</if>
         </trim>
    </insert>

    <update id="updateDContentlib" parameterType="DContentlib">
        update d_contentlib
        <trim prefix="SET" suffixOverrides=",">
            <if test="pid != null">pid = #{pid},</if>
            <if test="name != null "> name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="location != null and location != ''">location = #{location},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            <if test="creator != null and creator != ''">creator = #{creator},</if>
            <if test="creatorTime != null">creator_time = #{creatorTime},</if>
            <if test="modifier != null and modifier != ''">modifier = #{modifier},</if>
            <if test="modifierTime != null">modifier_time = #{modifierTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDContentlibById" parameterType="Long">
        delete from d_contentlib where id = #{id}
    </delete>

    <delete id="deleteDContentlibByIds" parameterType="String">
        delete from d_contentlib where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>