<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MonitorMapper">
    
    <resultMap type="MonitorPosition" id="MonitorPositionResult">
        <result property="x"    column="pos_x"    />
        <result property="y"    column="pos_y"    />
    </resultMap>

    <select id="selectMonitorPosition" resultMap="MonitorPositionResult">
        <!-- 
            模拟查询，实际请替换为真实的表查询
            例如: select pos_x, pos_y from sys_monitor_position where id = 1
        -->
        select 50.0 as pos_x, 50.0 as pos_y
    </select>
    
</mapper>
