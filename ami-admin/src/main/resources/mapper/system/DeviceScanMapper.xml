<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DeviceScanMapper">
    
    <resultMap type="DeviceScan" id="DeviceScanResult">
        <result property="id"    column="id"    />
        <result property="deviceId"    column="device_id"    />
        <result property="planId"    column="plan_id"    />
        <result property="zoneId"    column="zone_id"    />
        <result property="scanResult"    column="scan_result"    />
        <result property="scanRemark"    column="scan_remark"    />
        <result property="photos"    column="photos"    />
        <result property="deleted"    column="deleted"    />
        <result property="creator"    column="creator"    />
        <result property="creatorTime"    column="creator_time"    />
        <result property="modifier"    column="modifier"    />
        <result property="modifierTime"    column="modifier_time"    />
    </resultMap>

    <sql id="selectDeviceScanVo">
        select id, device_id, plan_id, zone_id, scan_result, scan_remark, photos, deleted, creator, creator_time, modifier, modifier_time from d_device_scan
    </sql>

    <select id="selectDeviceScanList" parameterType="DeviceScan" resultMap="DeviceScanResult">
        <include refid="selectDeviceScanVo"/>
        <where>  
            <if test="deviceId != null "> and device_id = #{deviceId}</if>
            <if test="planId != null "> and plan_id = #{planId}</if>
            <if test="zoneId != null "> and zone_id = #{zoneId}</if>
            <if test="scanResult != null "> and scan_result = #{scanResult}</if>
            <if test="scanRemark != null  and scanRemark != ''"> and scan_remark = #{scanRemark}</if>
            <if test="photos != null  and photos != ''"> and photos = #{photos}</if>
            <if test="deleted != null "> and deleted = #{deleted}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="creatorTime != null "> and creator_time = #{creatorTime}</if>
            <if test="modifier != null  and modifier != ''"> and modifier = #{modifier}</if>
            <if test="modifierTime != null "> and modifier_time = #{modifierTime}</if>
        </where>
    </select>
    
    <select id="selectDeviceScanById" parameterType="Long" resultMap="DeviceScanResult">
        <include refid="selectDeviceScanVo"/>
        where id = #{id}
    </select>

    <insert id="insertDeviceScan" parameterType="DeviceScan" useGeneratedKeys="true" keyProperty="id">
        insert into d_device_scan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id,</if>
            <if test="planId != null">plan_id,</if>
            <if test="zoneId != null">zone_id,</if>
            <if test="scanResult != null">scan_result,</if>
            <if test="scanRemark != null">scan_remark,</if>
            <if test="photos != null">photos,</if>
            <if test="deleted != null">deleted,</if>
            <if test="creator != null and creator != ''">creator,</if>
            <if test="creatorTime != null">creator_time,</if>
            <if test="modifier != null and modifier != ''">modifier,</if>
            <if test="modifierTime != null">modifier_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">#{deviceId},</if>
            <if test="planId != null">#{planId},</if>
            <if test="zoneId != null">#{zoneId},</if>
            <if test="scanResult != null">#{scanResult},</if>
            <if test="scanRemark != null">#{scanRemark},</if>
            <if test="photos != null">#{photos},</if>
            <if test="deleted != null">#{deleted},</if>
            <if test="creator != null and creator != ''">#{creator},</if>
            <if test="creatorTime != null">#{creatorTime},</if>
            <if test="modifier != null and modifier != ''">#{modifier},</if>
            <if test="modifierTime != null">#{modifierTime},</if>
         </trim>
    </insert>

    <update id="updateDeviceScan" parameterType="DeviceScan">
        update d_device_scan
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="zoneId != null">zone_id = #{zoneId},</if>
            <if test="scanResult != null">scan_result = #{scanResult},</if>
            <if test="scanRemark != null">scan_remark = #{scanRemark},</if>
            <if test="photos != null">photos = #{photos},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            <if test="creator != null and creator != ''">creator = #{creator},</if>
            <if test="creatorTime != null">creator_time = #{creatorTime},</if>
            <if test="modifier != null and modifier != ''">modifier = #{modifier},</if>
            <if test="modifierTime != null">modifier_time = #{modifierTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceScanById" parameterType="Long">
        delete from d_device_scan where id = #{id}
    </delete>

    <delete id="deleteDeviceScanByIds" parameterType="String">
        delete from d_device_scan where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>